<Page
    x:Class="Journal.Views.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Journal.ViewModels"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <!-- 快捷键仅作键序绑定：Ctrl+T 插入时间戳、Ctrl+S 保存；悬浮提示由 PlacementMode=Hidden 抑制 -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="InsertTimestampAccelerator_Invoked"/>
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveAccelerator_Invoked"/>
    </Page.KeyboardAccelerators>

    <Grid Background="Transparent">
        <!-- 响应式状态流：850px 断点平滑处理 750px 紧凑分屏与 4K 超宽屏视口 -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="850"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TimestampButtonText.Visibility" Value="Visible"/>
                        <Setter Target="SyncDotTextBlock.Visibility" Value="Visible"/>
                        <Setter Target="SaveStatusTextBlock.Visibility" Value="Visible"/>
                        <Setter Target="TimestampButton.Padding" Value="12,6"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TimestampButtonText.Visibility" Value="Collapsed"/>
                        <Setter Target="SyncDotTextBlock.Visibility" Value="Collapsed"/>
                        <Setter Target="SaveStatusTextBlock.Visibility" Value="Collapsed"/>
                        <Setter Target="TimestampButton.Padding" Value="8,6"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具控制条 -->
        <Border x:Name="TopToolBar" Padding="24,14,24,12" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 日期标题与快速翻页 -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.DateHeaderTitle, Mode=OneWay}"
                               FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>

                    <!-- 翻页 [<] [今天] [>] -->
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="12,0,0,0">
                        <Button Style="{ThemeResource SubtleButtonStyle}" Padding="6,4"
                                Command="{x:Bind ViewModel.GoToPreviousDayCommand}"
                                ToolTipService.ToolTip="前一天">
                            <FontIcon Glyph="&#xE76B;" FontSize="11"/>
                        </Button>
                        <Button Content="今天" Style="{ThemeResource SubtleButtonStyle}" Padding="8,4"
                                Command="{x:Bind ViewModel.GoToTodayCommand}"
                                ToolTipService.ToolTip="回到今天"/>
                        <Button Style="{ThemeResource SubtleButtonStyle}" Padding="6,4"
                                Command="{x:Bind ViewModel.GoToNextDayCommand}"
                                ToolTipService.ToolTip="后一天">
                            <FontIcon Glyph="&#xE76C;" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- 右侧动作按钮组：保存状态、自动保存开关、手动保存、时间戳 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- 保存状态与字数徽章 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.WordCount, Mode=OneWay}" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="字" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="SyncDotTextBlock" Text="·" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="SaveStatusTextBlock" Text="{x:Bind ViewModel.SaveStatusText, Mode=OneWay}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- 自动保存切换按钮 -->
                    <ToggleButton IsChecked="{x:Bind ViewModel.IsAutoSaveEnabled, Mode=TwoWay}"
                                  Style="{ThemeResource DefaultToggleButtonStyle}" Padding="8,5"
                                  ToolTipService.ToolTip="自动保存 (停顿后自动保存)">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE895;" FontSize="11"/>
                            <TextBlock Text="自动保存" FontSize="11"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- 手动保存按钮 (Ctrl+S) -->
                    <Button Style="{ThemeResource SubtleButtonStyle}" Padding="8,5"
                            Click="ManualSaveButton_Click"
                            ToolTipService.ToolTip="保存日记 (Ctrl+S)">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE74E;" FontSize="12"/>
                            <TextBlock Text="保存" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <!-- 插入时间戳按钮 (Ctrl+T) -->
                    <Button x:Name="TimestampButton" Style="{ThemeResource AccentButtonStyle}" Padding="12,6"
                            BorderThickness="0" CornerRadius="6"
                            Command="{x:Bind ViewModel.InsertTimestampCommand}"
                            ToolTipService.ToolTip="插入时间戳 (Ctrl+T)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE823;" FontSize="13"/>
                            <TextBlock x:Name="TimestampButtonText" Text="时间戳" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 编辑器保持视口大小；超长正文交给同一个 RichEditBox 滚动，避免为整篇文章分配巨幅遮罩表面。 -->
        <Grid x:Name="EditorViewport" Grid.Row="1" Padding="24,16,24,36"
              SizeChanged="EditorViewport_SizeChanged">
                <Grid x:Name="EditorPaperContainer" MaxWidth="860" HorizontalAlignment="Center">
                    <!-- 字形与风化遮罩始终来自同一个原生排版视口。 -->
                    <RichEditBox x:Name="ContentEditorBox"
                                 HorizontalAlignment="Stretch"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 IsSpellCheckEnabled="False"
                                 PlaceholderText="开始记录... (按 Ctrl+T 插入时间戳)"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CornerRadius="0"
                                 Padding="16,20"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollMode="Enabled"
                                 ScrollViewer.HorizontalScrollMode="Disabled">
                        <RichEditBox.Resources>
                            <!-- 彻底覆盖 WinUI 3 控件模板内置的背景与边框笔刷，根除点击时弹出矩形框与任何色差 -->
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
                            <!-- 焦点和悬停状态共用字色，避免控件模板把旧日记切回默认黑字。 -->
                            <SolidColorBrush x:Key="TextControlForeground" Color="#FF1A1A1A"/>
                            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FF1A1A1A"/>
                            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FF1A1A1A"/>
                        </RichEditBox.Resources>
                    </RichEditBox>

                    <!-- 字迹纹理只在编辑器实际绘出的笔画内显示，交互始终交给原生编辑器。 -->
                    <Border x:Name="InkWeatheringHost"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            IsHitTestVisible="False"
                            CornerRadius="4" />
                </Grid>
        </Grid>
    </Grid>
</Page>
