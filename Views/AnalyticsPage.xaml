<Page
    x:Class="Journal.Views.AnalyticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Journal.ViewModels"
    xmlns:models="using:Journal.Models"
    xmlns:controls="using:Journal.Controls"
    xmlns:local="using:Journal.Views"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="ReadingEdit_AcceleratorInvoked"/>
    </Page.KeyboardAccelerators>

    <Grid Background="Transparent">
        <!-- 1. 视图层级 1：数据统计大盘与核心意象词云 (Overview) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{x:Bind local:AnalyticsPage.GetVisibility(ViewModel.IsOverviewMode), Mode=OneWay}">
            <Grid Padding="24,16,24,32" RowSpacing="18" Background="Transparent" MaxWidth="1160">
                <!-- 响应式断点控制：860px 断点自适应 1x4 宽屏排版与 2x2 紧凑排版 -->
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="WideState">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="860"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="CardDays.(Grid.Row)" Value="0"/>
                                <Setter Target="CardDays.(Grid.Column)" Value="2"/>
                                <Setter Target="CardAvg.(Grid.Row)" Value="0"/>
                                <Setter Target="CardAvg.(Grid.Column)" Value="3"/>
                                <Setter Target="MetricCol2.Width" Value="*"/>
                                <Setter Target="MetricCol3.Width" Value="*"/>

                                <Setter Target="TierCard.(Grid.Row)" Value="0"/>
                                <Setter Target="TierCard.(Grid.Column)" Value="1"/>
                                <Setter Target="SplitCol1.Width" Value="*"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="CompactState">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="CardDays.(Grid.Row)" Value="1"/>
                                <Setter Target="CardDays.(Grid.Column)" Value="0"/>
                                <Setter Target="CardAvg.(Grid.Row)" Value="1"/>
                                <Setter Target="CardAvg.(Grid.Column)" Value="1"/>
                                <Setter Target="MetricCol2.Width" Value="0"/>
                                <Setter Target="MetricCol3.Width" Value="0"/>

                                <Setter Target="TierCard.(Grid.Row)" Value="1"/>
                                <Setter Target="TierCard.(Grid.Column)" Value="0"/>
                                <Setter Target="SplitCol1.Width" Value="0"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标头 -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE9D2;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="数据与统计" FontSize="22" FontWeight="Bold"/>
                </StackPanel>

                <!-- 1. 四大核心指标卡 -->
                <Grid x:Name="MetricsGrid" Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="MetricCol0" Width="*"/>
                        <ColumnDefinition x:Name="MetricCol1" Width="*"/>
                        <ColumnDefinition x:Name="MetricCol2" Width="*"/>
                        <ColumnDefinition x:Name="MetricCol3" Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="MetricRow0" Height="Auto"/>
                        <RowDefinition x:Name="MetricRow1" Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="CardStreak" Grid.Row="0" Grid.Column="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16,14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="连续记录" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                                <TextBlock Text="{x:Bind ViewModel.Stats.CurrentStreak, Mode=OneWay}"
                                           FontSize="26" FontWeight="Bold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="天" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="CardWords" Grid.Row="0" Grid.Column="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16,14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="累计总字数" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                                <TextBlock Text="{x:Bind ViewModel.Stats.TotalWords, Mode=OneWay}"
                                           FontSize="26" FontWeight="Bold"/>
                                <TextBlock Text="字" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="CardDays" Grid.Row="0" Grid.Column="2"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16,14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="记录天数" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                                <TextBlock Text="{x:Bind ViewModel.Stats.TotalDays, Mode=OneWay}"
                                           FontSize="26" FontWeight="Bold"/>
                                <TextBlock Text="天" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="CardAvg" Grid.Row="0" Grid.Column="3"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16,14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="日均字数" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                                <TextBlock Text="{x:Bind ViewModel.Stats.AverageDailyWords, Mode=OneWay}"
                                           FontSize="26" FontWeight="Bold"/>
                                <TextBlock Text="字" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2. 双栏深度文字统计：核心意象词云图谱 + 篇幅字数区间梯队分布 -->
                <Grid Grid.Row="2" ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SplitCol0" Width="1.15*"/>
                        <ColumnDefinition x:Name="SplitCol1" Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 左侧：核心意象与词云卡片 (点击任意词汇穿透浏览相关日记) -->
                    <Border Grid.Row="0" Grid.Column="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="18,16">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="核心词云" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="点击筛选日记" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 自适应流式词云容器 (支持点击按钮穿透检索与加载呼吸状态) -->
                            <Grid Margin="0,4,0,0">
                                <!-- 初次分析提炼时的温润加载占位微动效，消灭突兀空白 -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,32" Spacing="10"
                                            Visibility="{x:Bind local:AnalyticsPage.GetVisibility(ViewModel.IsWordCloudLoading), Mode=OneWay}">
                                    <ProgressRing IsActive="{x:Bind ViewModel.IsWordCloudLoading, Mode=OneWay}"
                                                  Width="22" Height="22"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="提炼意象图谱中..." FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <!-- 紧凑流式词云主体面板 -->
                                <ItemsControl ItemsSource="{x:Bind ViewModel.WordCloudWords, Mode=OneWay}"
                                              Visibility="{x:Bind local:AnalyticsPage.GetInverseVisibility(ViewModel.IsWordCloudLoading), Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:WordCloudPanel HorizontalSpacing="5" VerticalSpacing="3"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:WordCloudItem">
                                            <Button Style="{ThemeResource SubtleButtonStyle}" Padding="{x:Bind Padding}" CornerRadius="5"
                                                    BorderThickness="0" MinHeight="0" MinWidth="0"
                                                    Click="WordCloudItem_Click" Tag="{x:Bind}" Margin="0">
                                                <ToolTipService.ToolTip>
                                                    <ToolTip Content="{x:Bind ToolTipText}"/>
                                                </ToolTipService.ToolTip>
                                                <TextBlock Text="{x:Bind Word}"
                                                           FontSize="{x:Bind FontSize}"
                                                           Opacity="{x:Bind Opacity}"
                                                           Foreground="{x:Bind Foreground}"
                                                           FontWeight="{x:Bind FontWeight}"
                                                           VerticalAlignment="Center"/>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 右侧：篇幅字数分布卡片 -->
                    <Border x:Name="TierCard" Grid.Row="0" Grid.Column="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="18,16">
                        <StackPanel Spacing="14">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="篇幅字数分布" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{x:Bind ViewModel.DominantTierDescription, Mode=OneWay}"
                                       FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold"/>

                            <!-- 5 级梯队列表 -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.LengthTiers, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:LengthTierItem">
                                        <Grid Margin="0,0,0,10" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <ToolTipService.ToolTip>
                                                <ToolTip Content="{x:Bind ToolTipText}"/>
                                            </ToolTipService.ToolTip>

                                            <!-- 梯队名称 -->
                                            <TextBlock Text="{x:Bind TierName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                            <!-- 字数区间 -->
                                            <TextBlock Grid.Column="1" Text="{x:Bind RangeLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>

                                            <!-- 进度占比条 -->
                                            <ProgressBar Grid.Column="2" Value="{x:Bind Percentage}" Maximum="100"
                                                         Height="5" CornerRadius="2.5" VerticalAlignment="Center"
                                                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                                            <!-- 篇数 -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Count}" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="篇" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,1,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 3. 时段创作生物钟 (Circadian Rhythm Heatmap) -->
                <Border Grid.Row="3"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="18,16">
                    <StackPanel Spacing="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEC92;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="24小时记录时段分布" FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.PeakHourDescription, Mode=OneWay}"
                                   FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold"/>

                        <!-- 24 根时段柱状直方图 -->
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="90"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 直方条横向分布 -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.HourlyStats, Mode=OneWay}"
                                          VerticalAlignment="Bottom">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:HourlyHistogramPanel HorizontalAlignment="Stretch"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:HourlyHeatItem">
                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="2,0"
                                                Height="{x:Bind BarHeight}"
                                                CornerRadius="3"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                Opacity="0.85">
                                            <ToolTipService.ToolTip>
                                                <ToolTip Content="{x:Bind ToolTipText}"/>
                                            </ToolTipService.ToolTip>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 底部时间刻度行 (00, 03, 06, 09, 12, 15, 18, 21) -->
                            <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.HourlyStats, Mode=OneWay}"
                                          Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:HourlyHistogramPanel HorizontalAlignment="Stretch"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:HourlyHeatItem">
                                        <TextBlock Text="{x:Bind HourLabel}" FontSize="10"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. 近 12 个月书写趋势表 -->
                <Border Grid.Row="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="18,14">
                    <StackPanel Spacing="12">
                        <TextBlock Text="近 12 个月书写趋势" FontSize="14" FontWeight="SemiBold"/>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Stats.MonthlyStats, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:MonthlyWordStat">
                                    <Grid Margin="0,0,0,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{x:Bind MonthLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>

                                        <ProgressBar Grid.Column="1" Value="{x:Bind WordCount}" Maximum="{x:Bind MaxWordCount}"
                                                     Height="5" CornerRadius="2.5" VerticalAlignment="Center"
                                                     Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                                        <TextBlock Grid.Column="2" Text="{x:Bind WordCount}" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- 2. 视图层级 2：词云穿透之匹配日记列表 (WordList) -->
        <Grid Visibility="{x:Bind local:AnalyticsPage.GetVisibility(ViewModel.IsWordListMode), Mode=OneWay}"
              Padding="24,18,24,20" RowSpacing="16" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部操作条：返回概览按钮 + 标头 + 匹配篇数胶囊 (弹性网格自适应防截断) -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{ThemeResource SubtleButtonStyle}" Padding="10,6"
                        Command="{x:Bind ViewModel.CloseWordListCommand}" ToolTipService.ToolTip="返回词云与大盘"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="12"/>
                        <TextBlock Text="返回词云" FontSize="12"/>
                    </StackPanel>
                </Button>

                <Grid Grid.Column="1" ColumnSpacing="6" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8B9;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <Run Text="关键词「"/>
                        <Run Text="{x:Bind ViewModel.SelectedWord, Mode=OneWay}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <Run Text="」相关日记"/>
                    </TextBlock>
                </Grid>

                <Border Grid.Column="2" Background="{ThemeResource AppBadgeBackgroundBrush}" BorderBrush="{ThemeResource AppBadgeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.MatchedCount, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="篇匹配" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 主体：日记卡片列表 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid HorizontalAlignment="Stretch" Margin="0,4,0,24">
                    <!-- 空状态 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,80,0,0" Spacing="10"
                                Visibility="{x:Bind local:AnalyticsPage.GetEmptyVisibility(ViewModel.MatchedCount), Mode=OneWay}">
                        <FontIcon Glyph="&#xE8F1;" FontSize="36" Opacity="0.3" HorizontalAlignment="Center"/>
                        <TextBlock Text="未找到包含该词汇的日记" FontSize="14" Opacity="0.6" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.MatchedDiaries, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DiaryCardItem">
                                <Border Margin="0,0,0,10" Padding="16,14" CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Tag="{x:Bind}"
                                        Loaded="WordDiaryCard_Loaded"
                                        PointerPressed="WordDiaryCard_PointerPressed">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="68"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 左侧：大字号日期指示胶囊 -->
                                        <Border Grid.Column="0"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                CornerRadius="6" Padding="6,8" VerticalAlignment="Center">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{x:Bind DayString}" FontSize="20" FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="{x:Bind WeekDayString}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- 右侧：标题、徽章与摘录预览 -->
                                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 日记标题 (防碰撞单行省略) -->
                                                <TextBlock x:Name="CardTitleText" Grid.Column="0" Text="{x:Bind Title}" FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           Margin="0,0,8,0"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                                <!-- 右侧字数与记录点胶囊 -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Border Background="{ThemeResource AppBadgeBackgroundBrush}"
                                                            BorderBrush="{ThemeResource AppBadgeBorderBrush}"
                                                            BorderThickness="1" CornerRadius="4" Padding="7,2">
                                                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontWeight="SemiBold">
                                                            <Run Text="{x:Bind WordCount}"/>
                                                            <Run Text=" 字"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                                            <FontIcon Glyph="&#xE823;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                                <Run Text="{x:Bind TimestampsCount}"/>
                                                                <Run Text="条记录"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- 摘要预览 -->
                                            <TextBlock x:Name="CardExcerptText" Text="{x:Bind Excerpt}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Margin="0,0,12,0"
                                                       LineHeight="18"
                                                       MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- 3. 视图层级 3：单日只读阅读预览窗口 (双栏带右侧当月辅助日历，完全沿用目录模块) -->
        <Grid Visibility="{x:Bind local:AnalyticsPage.GetVisibility(ViewModel.IsReadingMode), Mode=OneWay}"
              Padding="24,18,24,20" ColumnSpacing="20" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ReadingCalendarPanelCol" Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：日记正文卡片视口 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
                <Grid HorizontalAlignment="Stretch" Margin="0,4,0,24">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="28,24">
                        <StackPanel Spacing="20">
                            <!-- 顶部信息栏与动作按钮组 -->
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 行 0：日期大标题 -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{x:Bind ViewModel.ReadingDateDisplay, Mode=OneWay}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>

                                <!-- 行 1 左侧：元数据徽章 (字数与记录点) -->
                                <StackPanel Grid.Row="1" Grid.Column="0"
                                            Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Background="{ThemeResource AppBadgeBackgroundBrush}" BorderBrush="{ThemeResource AppBadgeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                        <TextBlock Text="{x:Bind ViewModel.ReadingWordCount, Mode=OneWay}"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="8,3">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE823;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{x:Bind ViewModel.ReadingTimestampsCount, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="条记录" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 行 1 右侧：编辑按钮 + 返回列表按钮 -->
                                <StackPanel Grid.Row="1" Grid.Column="1"
                                            Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Style="{ThemeResource AccentButtonStyle}" Padding="12,7" CornerRadius="6"
                                            Click="ReadingEdit_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                             <FontIcon Glyph="&#xE70F;" FontSize="12"/>
                                            <TextBlock Text="编辑 (Ctrl+E)" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{ThemeResource DefaultButtonStyle}" Padding="12,7" CornerRadius="6"
                                            Command="{x:Bind ViewModel.CloseReadingCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72B;" FontSize="12"/>
                                            <TextBlock Text="返回列表" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <MenuFlyoutSeparator Margin="0,-4,0,4"/>

                            <!-- 正文阅读区域 -->
                            <StackPanel Spacing="14">
                                <TextBlock x:Name="ReadingDiaryTitleText"
                                           Text="{x:Bind ViewModel.ReadingDiaryTitle, Mode=OneWay}"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="ReadingDiaryContentText"
                                           Text="{x:Bind ViewModel.ReadingDiaryContent, Mode=OneWay}"
                                           FontSize="15" LineHeight="26"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           IsTextSelectionEnabled="True"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- 右侧：当月日历辅助观察面板 -->
            <Border x:Name="ReadingAuxiliaryPanel" Grid.Column="1" VerticalAlignment="Top"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="16,14" Width="344">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="2,0,0,2">
                        <FontIcon Glyph="&#xE787;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="当月日历" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- 原生 CalendarView 辅助观察 -->
                    <CalendarView x:Name="ReadingAuxiliaryCalendarView"
                                  SelectionMode="Single"
                                  HorizontalAlignment="Center"
                                  IsTodayHighlighted="True"
                                  CalendarViewDayItemChanging="ReadingAuxiliaryCalendarView_CalendarViewDayItemChanging"
                                  SelectedDatesChanged="ReadingAuxiliaryCalendarView_SelectedDatesChanged"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
