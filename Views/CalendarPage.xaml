<Page
    x:Class="Journal.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Journal.ViewModels"
    xmlns:models="using:Journal.Models"
    xmlns:controls="using:Journal.Controls"
    xmlns:local="using:Journal.Views"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="EditCurrentDayDiary_AcceleratorInvoked"/>
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <!-- 年视图中的紧凑天数单元格模板（随缩放比例自适应拉伸） -->
        <DataTemplate x:Key="CompactDayTemplate" x:DataType="models:DayHeatmapItem">
            <Border MinHeight="20" MinWidth="20" CornerRadius="4"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="{x:Bind DayBackground}"
                    PointerPressed="DayItem_PointerPressed">
                <ToolTipService.ToolTip>
                    <ToolTip MaxWidth="320" Padding="12,10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind DetailHeaderTitle}" FontWeight="SemiBold" FontSize="12"/>
                            <StackPanel Visibility="{x:Bind ActivityBadgeVisibility}" Spacing="2">
                                <TextBlock Text="{x:Bind WordBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AppAccentTextBrush}"/>
                                <TextBlock Text="{x:Bind TimestampBadgeText}" FontSize="11" Opacity="0.85"/>
                                <TextBlock Text="{x:Bind Excerpt}" Visibility="{x:Bind HasExcerptVisibility}" FontSize="11" TextWrapping="Wrap" Opacity="0.85"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind NoActivityTip}" Visibility="{x:Bind NoActivityVisibility}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </ToolTip>
                </ToolTipService.ToolTip>
                <TextBlock Text="{x:Bind DayNumber}" FontSize="11"
                           FontWeight="{x:Bind DayFontWeight}"
                           Foreground="{x:Bind DayForeground}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,18,16,20" RowSpacing="16" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. 顶部日历导航控制条（集成今天/本月/今年主按钮与层级切换） -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧大标题：年份或年月或日期 -->
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE787;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="{x:Bind ViewModel.HeaderTitle, Mode=OneWay}" 
                           FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 右侧操作工具条：[返回上级] + [<] + [>] + [回到今天] + [年/月切换] -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <!-- 快捷返回上一层级按钮 -->
                <Button Style="{ThemeResource SubtleButtonStyle}"
                        Command="{x:Bind ViewModel.BackToUpperLevelCommand}"
                        Visibility="{x:Bind local:CalendarPage.GetVisibility(ViewModel.IsUpperLevelButtonVisible), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE72B;" FontSize="11"/>
                        <TextBlock Text="{x:Bind ViewModel.UpperLevelButtonText, Mode=OneWay}" FontSize="12"/>
                    </StackPanel>
                </Button>

                <!-- 前一个周期 [<] 与 后一个周期 [>] 成对编组 -->
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Style="{ThemeResource SubtleButtonStyle}"
                            Command="{x:Bind ViewModel.PrevPeriodCommand}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.PrevPeriodTooltip, Mode=OneWay}"
                            Padding="8,6">
                        <FontIcon Glyph="&#xE76B;" FontSize="11"/>
                    </Button>
                    <Button Style="{ThemeResource SubtleButtonStyle}"
                            Command="{x:Bind ViewModel.NextPeriodCommand}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.NextPeriodTooltip, Mode=OneWay}"
                            Padding="8,6">
                        <FontIcon Glyph="&#xE76C;" FontSize="11"/>
                    </Button>
                </StackPanel>

                <!-- 回到今天 -->
                <Button Style="{ThemeResource SubtleButtonStyle}"
                        Command="{x:Bind ViewModel.JumpToCurrentCommand}"
                        ToolTipService.ToolTip="回到今天">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE8D1;" FontSize="11"/>
                        <TextBlock Text="回到今天" FontSize="12"/>
                    </StackPanel>
                </Button>

                <!-- 年/月视图直接切换 -->
                <Button Style="{ThemeResource DefaultButtonStyle}"
                        Command="{x:Bind ViewModel.ToggleYearMonthViewCommand}"
                        ToolTipService.ToolTip="切换视图层级">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="{x:Bind ViewModel.ViewToggleGlyph, Mode=OneWay}" FontSize="12"/>
                        <TextBlock Text="{x:Bind ViewModel.ViewToggleText, Mode=OneWay}" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. 年概览指标看板行 (仅在年视图下优雅展现) -->
        <Grid Grid.Row="1" ColumnSpacing="12"
              Visibility="{x:Bind local:CalendarPage.GetVisibility(ViewModel.IsYearView), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="14,10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8D2;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="总字数" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.TotalYearWords, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="字" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="14,10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xED28;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="记录天数" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.TotalActiveDays, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="天" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="14,10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="连续天数" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.CurrentStreak, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="天" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. 主体内容区：支持三级视图（年视图、月视图、单日只读阅读视图） -->
        <Grid Grid.Row="2">

            <!-- 层级 1：年视图（12 个月平铺网格，原生弹性自适应流式排版） -->
            <ScrollViewer x:Name="YearScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,12,0"
                          Visibility="{x:Bind local:CalendarPage.GetVisibility(ViewModel.IsYearView), Mode=OneWay}">
                <ItemsRepeater x:Name="YearItemsRepeater" ItemsSource="{x:Bind ViewModel.YearMonths, Mode=OneWay}"
                               HorizontalAlignment="Stretch" Margin="0,0,0,16">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout x:Name="YearUniformGridLayout"
                                           MinItemWidth="230" MinItemHeight="286"
                                           MinRowSpacing="16" MinColumnSpacing="16"
                                           MaximumRowsOrColumns="4"
                                           ItemsStretch="Fill"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:YearMonthItem">
                            <Border HorizontalAlignment="Stretch"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,10,12,12">
                                <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                                    <!-- 月份标题：点击钻取至该月 -->
                                    <Button Tag="{x:Bind Month}" Padding="6,3" HorizontalAlignment="Left" 
                                            Style="{ThemeResource SubtleButtonStyle}"
                                            Click="MonthHeader_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind MonthTitle}" FontWeight="Bold" FontSize="14"/>
                                            <FontIcon Glyph="&#xE76C;" FontSize="10" Opacity="0.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 星期标头行：日 一 二 三 四 五 六 -->
                                    <Grid ColumnSpacing="4" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind SunShort}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind MonShort}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind TueShort}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind WedShort}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind ThuShort}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{x:Bind FriShort}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="{x:Bind SatShort}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                    </Grid>

                                    <!-- 42 天紧凑数字网格（6行 × 7列精准数学排布） -->
                                    <ItemsControl ItemsSource="{x:Bind Days}"
                                                  ItemTemplate="{StaticResource CompactDayTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:CalendarGridPanel RowSpacing="4" ColumnSpacing="4" CellHeight="24" UseYearZoomHeight="True" FixSixRows="True"
                                                                            Loaded="YearCalendarGridPanel_Loaded" Unloaded="YearCalendarGridPanel_Unloaded"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- 层级 2：月视图（单月放大特写，100% 弹性拉伸充满视口） -->
            <ScrollViewer x:Name="MonthScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,12,0"
                          Visibility="{x:Bind local:CalendarPage.GetVisibility(ViewModel.IsMonthView), Mode=OneWay}">
                <Border x:Name="MonthDetailViewBorder" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="18">
                    <!-- 月特写主体：星期表头 + 满屏弹性自适应 6 行日历矩阵 -->
                    <Grid RowSpacing="8" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 星期表头行（周日到周六） -->
                        <Grid ColumnSpacing="6" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="周日" HorizontalAlignment="Center" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="周一" HorizontalAlignment="Center" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="周二" HorizontalAlignment="Center" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="周三" HorizontalAlignment="Center" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="4" Text="周四" HorizontalAlignment="Center" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="5" Text="周五" HorizontalAlignment="Center" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="6" Text="周六" HorizontalAlignment="Center" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>

                        <!-- 42 天大单元格网格（高精日历格，均分填满视口空间） -->
                        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.CurrentMonthDays, Mode=OneWay}"
                                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:CalendarGridPanel RowSpacing="6" ColumnSpacing="6" IsAdaptiveHeight="True" MinAdaptiveCellHeight="72" FixSixRows="True"
                                                                Loaded="MonthCalendarGridPanel_Loaded" Unloaded="MonthCalendarGridPanel_Unloaded"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DayHeatmapItem">
                                        <Border CornerRadius="6" Padding="8,6"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                PointerPressed="DayItem_PointerPressed">
                                            <ToolTipService.ToolTip>
                                                <ToolTip MaxWidth="360" Padding="14,12">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Text="{x:Bind DetailHeaderTitle}" FontWeight="SemiBold" FontSize="13"/>
                                                        <StackPanel Visibility="{x:Bind ActivityBadgeVisibility}" Spacing="3">
                                                            <TextBlock Text="{x:Bind WordBadgeText}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppAccentTextBrush}"/>
                                                            <TextBlock Text="{x:Bind TimestampBadgeText}" FontSize="11" Opacity="0.85"/>
                                                            <TextBlock Text="{x:Bind CalendarExcerpt}" Visibility="{x:Bind HasExcerptVisibility}" FontSize="11" TextWrapping="Wrap" Opacity="0.85"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{x:Bind NoActivityTip}" Visibility="{x:Bind NoActivityVisibility}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </ToolTipService.ToolTip>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <!-- 单元格顶部信息栏：左侧字数徽章 + 右侧日期号 -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 字数微胶囊 (无日记时隐藏 0 字标签) -->
                                                    <Border CornerRadius="3" Padding="4,1" HorizontalAlignment="Left"
                                                            Background="{ThemeResource AppBadgeBackgroundBrush}"
                                                            Visibility="{x:Bind ActivityBadgeVisibility}">
                                                        <TextBlock Text="{x:Bind WordBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AppAccentTextBrush}"/>
                                                    </Border>

                                                    <!-- 日期号 -->
                                                    <Border Grid.Column="1" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right"
                                                            Background="{x:Bind DayBackground}">
                                                        <TextBlock Text="{x:Bind DayNumber}" FontSize="11"
                                                                   FontWeight="{x:Bind DayFontWeight}"
                                                                   Foreground="{x:Bind DayForeground}"/>
                                                    </Border>
                                                </Grid>

                                                <!-- 单元格正文真实文字缩略预览（字号清晰、呼吸行距、自适应截断） -->
                                                <TextBlock Grid.Row="1" Text="{x:Bind CalendarExcerpt}"
                                                           Visibility="{x:Bind HasExcerptVisibility}"
                                                           FontSize="11" MaxLines="3" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                                           Opacity="0.82" Margin="0,4,0,0" VerticalAlignment="Top"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                    </Grid>
                </Border>
            </ScrollViewer>

            <!-- 层级 3：单日只读日记阅读窗口层级 (双栏自适应 + 右侧当月辅助日历) -->
            <Grid Visibility="{x:Bind local:CalendarPage.GetVisibility(ViewModel.IsDayView), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="DayCalendarPanelCol" Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：日记正文卡片视口 -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
                    <Grid HorizontalAlignment="Stretch" Margin="0,4,0,24">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="28,24">
                            <StackPanel Spacing="20">
                                <!-- 顶部信息栏与动作按钮 -->
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 行 0：日期大标题 -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{x:Bind ViewModel.SelectedDayDateDisplay, Mode=OneWay}"
                                               FontSize="22" FontWeight="Bold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>

                                    <!-- 行 1 左侧：元数据徽章 (字数与记录点) -->
                                    <StackPanel Grid.Row="1" Grid.Column="0"
                                                Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Background="{ThemeResource AppBadgeBackgroundBrush}"
                                                BorderBrush="{ThemeResource AppBadgeBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6" Padding="8,3">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedDayWordCountDisplay, Mode=OneWay}"
                                                       FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="8,3">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE823;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="{x:Bind ViewModel.SelectedDayTimestampsCount, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="条记录" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- 行 1 右侧：编辑按钮 + 删除按钮 + 返回月视图按钮 -->
                                    <StackPanel Grid.Row="1" Grid.Column="1"
                                                Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Style="{ThemeResource AccentButtonStyle}" Padding="14,7" CornerRadius="6"
                                                Click="EditCurrentDayDiary_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE70F;" FontSize="12"/>
                                                <TextBlock Text="编辑 (Ctrl+E)" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Padding="12,7" CornerRadius="6"
                                                Background="#1AF43F5E" BorderBrush="#4DF43F5E" BorderThickness="1"
                                                Visibility="{x:Bind local:CalendarPage.GetVisibility(ViewModel.SelectedDayHasDiary), Mode=OneWay}"
                                                Click="DeleteCurrentDayDiary_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="#F43F5E"/>
                                                <TextBlock Text="删除" FontSize="12" Foreground="#F43F5E" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{ThemeResource DefaultButtonStyle}" Padding="12,7" CornerRadius="6"
                                                Command="{x:Bind ViewModel.SwitchToMonthViewCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE787;" FontSize="12"/>
                                                <TextBlock Text="返回月视图" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <MenuFlyoutSeparator Margin="0,-4,0,4"/>

                                <!-- 日记正文阅读区（若有日记） -->
                                <StackPanel Spacing="14" Visibility="{x:Bind local:CalendarPage.GetVisibility(ViewModel.SelectedDayHasDiary), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedDayDiaryTitle, Mode=OneWay}"
                                               FontSize="18" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedDayDiaryContent, Mode=OneWay}"
                                               FontSize="15" LineHeight="26"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               IsTextSelectionEnabled="True"/>
                                </StackPanel>

                                <!-- 空日记提示区（若无日记） -->
                                <StackPanel Spacing="14" HorizontalAlignment="Center" Margin="0,40,0,40"
                                            Visibility="{x:Bind local:CalendarPage.GetInverseVisibility(ViewModel.SelectedDayHasDiary), Mode=OneWay}">
                                    <FontIcon Glyph="&#xE82D;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="无记录" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                    <Button Content="写日记" Style="{ThemeResource AccentButtonStyle}"
                                            HorizontalAlignment="Center" Margin="0,8,0,0"
                                            Click="EditCurrentDayDiary_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- 右侧：当月辅助日历观察面板 -->
                <Border x:Name="DayAuxiliaryPanel" Grid.Column="1" VerticalAlignment="Top"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="16,14" Width="344" Margin="16,0,0,0">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="2,0,0,2">
                            <FontIcon Glyph="&#xE787;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="当月日历" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- 原生 CalendarView 辅助观察 -->
                        <CalendarView x:Name="DayAuxiliaryCalendarView"
                                      HorizontalAlignment="Center"
                                      SelectionMode="Single"
                                      IsTodayHighlighted="True"
                                      CalendarViewDayItemChanging="DayAuxiliaryCalendarView_CalendarViewDayItemChanging"
                                      SelectedDatesChanged="DayAuxiliaryCalendarView_SelectedDatesChanged"/>

                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="DayAuxDateStatusText"
                                           Text="点击日期查看日记"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                                <Button x:Name="DayAuxWriteButton"
                                        Content="编辑此篇日记"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Padding="10,5"
                                        FontSize="12"
                                        Visibility="Collapsed"
                                        Click="EditCurrentDayDiary_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
