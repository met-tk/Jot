<Page
    x:Class="Journal.Views.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Journal.ViewModels"
    xmlns:models="using:Journal.Models"
    xmlns:local="using:Journal.Views"
    mc:Ignorable="d"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop">

    <Grid Background="Transparent">
        <!-- 状态 1：空状态投放区 (尚未载入任何文件时呈现) -->
        <Grid Visibility="{x:Bind local:ImportPage.GetInvertedVisibility(ViewModel.HasEntries), Mode=OneWay}"
              Padding="32,24,32,32">
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="48,40"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Grid RowSpacing="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 中心引导区 -->
                    <StackPanel Grid.Row="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="18">
                        <Border Width="88"
                                Height="88"
                                CornerRadius="44"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8B5;"
                                      FontSize="38"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>

                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="拖拽日记文件或文件夹至此"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="支持 Markdown (.md, .txt)、Notion/Day One 导出的 JSON 以及 ZIP 压缩包"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- 操作按钮组 -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="14"
                                    HorizontalAlignment="Center"
                                    Margin="0,8,0,0">
                            <Button Style="{ThemeResource AccentButtonStyle}"
                                    Padding="18,9"
                                    CornerRadius="8"
                                    Command="{x:Bind ViewModel.PickFilesCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="15" />
                                    <TextBlock Text="选取日记文件" />
                                </StackPanel>
                            </Button>

                            <Button Style="{ThemeResource DefaultButtonStyle}"
                                    Padding="18,9"
                                    CornerRadius="8"
                                    Command="{x:Bind ViewModel.PickFolderCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xED25;" FontSize="15" />
                                    <TextBlock Text="选取文件夹" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- 解析中状态指示器 -->
                        <StackPanel Visibility="{x:Bind local:ImportPage.GetVisibility(ViewModel.IsScanning), Mode=OneWay}"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    HorizontalAlignment="Center"
                                    Margin="0,12,0,0">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Width="18" Height="18" />
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                       FontSize="13"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 底部特性指引胶囊卡片 -->
                    <Grid Grid.Row="1"
                          ColumnSpacing="16"
                          MaxWidth="840"
                          HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 特性 1 -->
                        <Border Grid.Column="0"
                                Padding="16,14"
                                CornerRadius="10"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE787;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="智能日期识别" FontWeight="Medium" FontSize="13" />
                                </StackPanel>
                                <TextBlock Text="从文件名、YAML 标头、正文首行及时间戳自动解析归属日期"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- 特性 2 -->
                        <Border Grid.Column="1"
                                Padding="16,14"
                                CornerRadius="10"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="一日一档无缝追加" FontWeight="Medium" FontSize="13" />
                                </StackPanel>
                                <TextBlock Text="相同日期自动以 [HH:mm:ss] 时间戳节点智能合并追加，不冲掉已有记录"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- 特性 3 -->
                        <Border Grid.Column="2"
                                Padding="16,14"
                                CornerRadius="10"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8F1;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="对照与合并预览" FontWeight="Medium" FontSize="13" />
                                </StackPanel>
                                <TextBlock Text="导入前提供本地现有内容与待导入内容的左右对照及合并预览"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态 2：已载入候选日记，富双栏工作台 (HasEntries == true) -->
        <Grid Visibility="{x:Bind local:ImportPage.GetVisibility(ViewModel.HasEntries), Mode=OneWay}"
              Padding="24,16,24,20"
              RowSpacing="14">
            <Grid.RowDefinitions>
                <!-- 顶部操作与状态栏 -->
                <RowDefinition Height="Auto" />
                <!-- 规则识别控制台卡片条 -->
                <RowDefinition Height="Auto" />
                <!-- 进度指示条 -->
                <RowDefinition Height="Auto" />
                <!-- 双栏主体内容区 -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部操作栏 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧统计摘要 -->
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="日记导入工作台" FontSize="20" FontWeight="SemiBold" />
                        <Border CornerRadius="6"
                                Padding="8,2"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind ViewModel.DateRangeText, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <Border CornerRadius="6"
                                Padding="8,2"
                                Background="{ThemeResource AppBadgeBackgroundBrush}"
                                BorderBrush="{ThemeResource AppBadgeBorderBrush}"
                                BorderThickness="1">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                                <Run Text="候选 " /><Run Text="{x:Bind ViewModel.ValidCount, Mode=OneWay}" /><Run Text=" 篇" />
                            </TextBlock>
                        </Border>
                        <Border Visibility="{x:Bind local:ImportPage.GetCountVisibility(ViewModel.ConflictedCount), Mode=OneWay}"
                                CornerRadius="6"
                                Padding="8,2"
                                BorderBrush="#66E08000"
                                BorderThickness="1"
                                Background="#20E08000">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#D07000">
                                <Run Text="已有重合 " /><Run Text="{x:Bind ViewModel.ConflictedCount, Mode=OneWay}" /><Run Text=" 篇" />
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- 右侧冲突策略与核心控制项 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- 冲突策略下拉 -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="冲突策略:" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox SelectedIndex="{x:Bind local:ImportPage.ConflictStrategyToIndex(ViewModel.ConflictStrategy), Mode=OneWay}"
                                  SelectionChanged="ConflictStrategyCombo_SelectionChanged"
                                  Width="140"
                                  CornerRadius="6">
                            <ComboBoxItem Content="智能追加合并" Tag="MergeAppend" ToolTipService.ToolTip="保留已有日记，并在末尾追加新记录" />
                            <ComboBoxItem Content="覆盖已有日记" Tag="Overwrite" ToolTipService.ToolTip="彻底替换为待导入内容" />
                            <ComboBoxItem Content="跳过已有日期" Tag="Skip" ToolTipService.ToolTip="忽略本地已有日记的日期" />
                        </ComboBox>
                    </StackPanel>

                    <!-- 过滤模式 -->
                    <ComboBox SelectedIndex="{x:Bind local:ImportPage.FilterModeToIndex(ViewModel.FilterMode), Mode=OneWay}"
                              SelectionChanged="FilterModeCombo_SelectionChanged"
                              Width="110"
                              CornerRadius="6">
                        <ComboBoxItem Content="全部候选" />
                        <ComboBoxItem Content="仅看重合" />
                        <ComboBoxItem Content="仅看新增" />
                    </ComboBox>

                    <!-- 重新载入 / 清空 -->
                    <Button Style="{ThemeResource SubtleButtonStyle}"
                            Command="{x:Bind ViewModel.ClearCommand}"
                            IsEnabled="{x:Bind local:ImportPage.GetInvertedBool(ViewModel.IsImporting), Mode=OneWay}"
                            ToolTipService.ToolTip="清空当前列表并重新选择">
                        <FontIcon Glyph="&#xE894;" FontSize="14" />
                    </Button>

                    <!-- 确认执行导入按钮 -->
                    <Button Style="{ThemeResource AccentButtonStyle}"
                            Padding="16,8"
                            CornerRadius="8"
                            IsEnabled="{x:Bind ViewModel.CanExecuteImport, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ExecuteImportCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                            <TextBlock>
                                <Run Text="确认导入 (" /><Run Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}" /><Run Text=" 篇)" />
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 规则识别控制台卡片条 -->
            <Border Grid.Row="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：规则选择与自定义正则输入 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE90A;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="拆分识别规则:" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>

                        <ComboBox SelectedIndex="{x:Bind local:ImportPage.RulePresetToIndex(ViewModel.SelectedRulePreset), Mode=OneWay}"
                                  SelectionChanged="RulePresetCombo_SelectionChanged"
                                  Width="180"
                                  CornerRadius="6">
                            <ComboBoxItem Content="智能探测 (推荐)" ToolTipService.ToolTip="存在多日标记时自动切分，否则整篇导入" />
                            <ComboBoxItem Content="整篇不拆分" ToolTipService.ToolTip="将每个文件作为单一整篇日记导入" />
                            <ComboBoxItem Content="按 Markdown 标题拆分" ToolTipService.ToolTip="按 # 2026-10-01 或 ## 2026年10月1日 标头拆分" />
                            <ComboBoxItem Content="按方括号时间戳拆分" ToolTipService.ToolTip="按 [2026-10-01 08:30:00] 或 [2026-10-01] 拆分，纯时分秒留在当天内" />
                            <ComboBoxItem Content="按分割线拆分" ToolTipService.ToolTip="按 --- 2026-10-01 --- 或 === 2026.10.01 === 拆分" />
                            <ComboBoxItem Content="按独占纯日期行拆分" ToolTipService.ToolTip="按独立一行的 2026-10-01 或 2026年10月1日 拆分" />
                            <ComboBoxItem Content="自定义正则表达式" ToolTipService.ToolTip="输入自定义正则表达式匹配日期分割行" />
                        </ComboBox>

                        <!-- 自定义正则输入框 (仅在自定义正则模式下可见) -->
                        <TextBox Visibility="{x:Bind local:ImportPage.GetVisibility(ViewModel.IsCustomRegexVisible), Mode=OneWay}"
                                 Text="{x:Bind ViewModel.CustomRegexPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="输入自定义正则（如 ^#+\s*(\d{4}-\d{2}-\d{2})）"
                                 Width="280"
                                 CornerRadius="6"
                                 VerticalAlignment="Center" />

                        <!-- 重新应用规则按钮 -->
                        <Button Style="{ThemeResource AccentButtonStyle}"
                                Padding="12,6"
                                CornerRadius="6"
                                Command="{x:Bind ViewModel.ReapplyRuleCommand}"
                                ToolTipService.ToolTip="基于当前选中的规则即时在内存中重新切片并预览">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                <TextBlock Text="应用规则" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 右侧提示 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="已载入内存池，切换规则实时重切片"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 进度条（导入中呈现） -->
            <ProgressBar Grid.Row="2"
                         Visibility="{x:Bind local:ImportPage.GetVisibility(ViewModel.IsImporting), Mode=OneWay}"
                         Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                         Maximum="100"
                         Height="3"
                         Margin="0,-8,0,-4" />

            <!-- 双栏主体区 -->
            <Grid Grid.Row="3" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <!-- 左栏：候选列表 -->
                    <ColumnDefinition Width="400" MinWidth="340" MaxWidth="460" />
                    <!-- 右栏：富对照与预演面板 -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左栏卡片列表容器 -->
                <Border Grid.Column="0"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- 列表批量操作快捷条 -->
                            <RowDefinition Height="Auto" />
                            <!-- 列表主体 -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 列表快速全选/反选栏 -->
                        <Border Grid.Row="0"
                                Padding="12,8"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Style="{ThemeResource DefaultButtonStyle}"
                                            Padding="8,3"
                                            CornerRadius="5"
                                            FontSize="12"
                                            Command="{x:Bind ViewModel.SelectAllCommand}">
                                        <TextBlock Text="全选" />
                                    </Button>
                                    <Button Style="{ThemeResource DefaultButtonStyle}"
                                            Padding="8,3"
                                            CornerRadius="5"
                                            FontSize="12"
                                            Command="{x:Bind ViewModel.DeselectAllCommand}">
                                        <TextBlock Text="全不选" />
                                    </Button>
                                    <Button Style="{ThemeResource DefaultButtonStyle}"
                                            Padding="8,3"
                                            CornerRadius="5"
                                            FontSize="12"
                                            Command="{x:Bind ViewModel.InvertSelectionCommand}">
                                        <TextBlock Text="反选" />
                                    </Button>
                                    <Button Background="#14E11D48"
                                            BorderBrush="#45E11D48"
                                            BorderThickness="1"
                                            Padding="8,3"
                                            CornerRadius="5"
                                            FontSize="12"
                                            Command="{x:Bind ViewModel.RemoveSelectedCommand}"
                                            ToolTipService.ToolTip="批量移除已勾选的条目">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#E11D48" />
                                            <TextBlock Text="移除已选" Foreground="#E11D48" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <TextBlock HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="已选 " /><Run Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" / " /><Run Text="{x:Bind ViewModel.FilteredEntries.Count, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- 候选日记列表 -->
                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.FilteredEntries, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedEntry, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  Padding="6">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="6,4" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ImportedEntryPreview">
                                    <Grid Padding="6,8" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 勾选框 -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                  MinWidth="26"
                                                  Width="26"
                                                  VerticalAlignment="Center" />

                                        <!-- 日记条目内容 (三层独立网格，0 重叠隐患) -->
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <!-- 第 1 行：左侧日期与星期 + 右侧冲突/新记录徽章 -->
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind DateDisplay, Mode=OneWay}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13.5"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind WeekDayDisplay, Mode=OneWay}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- 冲突/新记录徽章 -->
                                                <Border Grid.Column="1"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center"
                                                        Background="{x:Bind local:ImportPage.GetConflictBadgeBackground(HasConflict), Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind ConflictDisplayText, Mode=OneWay}"
                                                               FontSize="11"
                                                               FontWeight="Medium"
                                                               Foreground="{x:Bind local:ImportPage.GetConflictBadgeForeground(HasConflict), Mode=OneWay}" />
                                                </Border>
                                            </Grid>

                                            <!-- 第 2 行：2行摘要预览 -->
                                            <TextBlock Text="{x:Bind Excerpt}"
                                                       FontSize="12"
                                                       LineHeight="17"
                                                       MaxLines="2"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                            <!-- 第 3 行：左侧字数/段数元数据 + 右侧微操作按钮组 (改期/单篇导入/移除) -->
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                        <Run Text="字数: " /><Run Text="{x:Bind WordCount, Mode=OneWay}" FontWeight="SemiBold" />
                                                    </TextBlock>
                                                    <TextBlock Visibility="{x:Bind local:ImportPage.GetCountVisibility(TimestampsCount), Mode=OneWay}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                        <Run Text="· 时间戳: " /><Run Text="{x:Bind TimestampsCount, Mode=OneWay}" /><Run Text=" 段" />
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- 右侧微操作按钮 -->
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            Spacing="2"
                                                            VerticalAlignment="Center">
                                                    <!-- 快捷微调日期按钮 -->
                                                    <Button Style="{ThemeResource SubtleButtonStyle}"
                                                            Padding="5,3"
                                                            ToolTipService.ToolTip="调整此篇归属日期">
                                                        <FontIcon Glyph="&#xE787;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <Button.Flyout>
                                                            <DatePickerFlyout Date="{x:Bind DateOffset, Mode=TwoWay}" />
                                                        </Button.Flyout>
                                                    </Button>

                                                    <!-- 单独直接导入此篇按钮 -->
                                                    <Button Style="{ThemeResource SubtleButtonStyle}"
                                                            Padding="5,3"
                                                            Click="ImportSingleEntryBtn_Click"
                                                            ToolTipService.ToolTip="立即单独导入此篇">
                                                        <FontIcon Glyph="&#xE8B5;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    </Button>

                                                    <!-- 移除此条目按钮 -->
                                                    <Button Style="{ThemeResource SubtleButtonStyle}"
                                                            Padding="5,3"
                                                            Click="RemoveEntryBtn_Click"
                                                            ToolTipService.ToolTip="从导入候选中移除此条目">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#E11D48" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- 右栏：富对照与合并预演容器 -->
                <Border Grid.Column="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Padding="16">
                    <Grid>
                        <!-- 未选中任何条目时的空状态 -->
                        <StackPanel Visibility="{x:Bind local:ImportPage.GetInvertedVisibility(ViewModel.HasSelectedEntry), Mode=OneWay}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12">
                            <FontIcon Glyph="&#xE7C3;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="请在左侧列表中点击选择日记以查看预览"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- 选中条目时的预览工作区 -->
                        <Grid Visibility="{x:Bind local:ImportPage.GetVisibility(ViewModel.HasSelectedEntry), Mode=OneWay}"
                              RowSpacing="12">
                            <Grid.RowDefinitions>
                                <!-- 预览顶栏选项卡与统计 -->
                                <RowDefinition Height="Auto" />
                                <!-- 预览正文区 -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 顶栏：Tab 切换与指标胶囊 -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 预览模式切换 -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="TabBtnSideBySide"
                                            Click="TabBtnSideBySide_Click"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Padding="12,6"
                                            CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8F1;" FontSize="13" />
                                            <TextBlock Text="左右对照" />
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="TabBtnMerged"
                                            Click="TabBtnMerged_Click"
                                            Style="{ThemeResource DefaultButtonStyle}"
                                            Padding="12,6"
                                            CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                            <TextBlock Text="合并预览" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- 右侧指标比对胶囊 -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="10"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Border Visibility="{x:Bind local:ImportPage.GetVisibility(ViewModel.SelectedEntryHasConflict), Mode=OneWay}"
                                            CornerRadius="6"
                                            Padding="8,3"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock FontSize="12">
                                            <Run Text="本地现有: " Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Run Text="{x:Bind ViewModel.SelectedEntryExistingWords, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" 字" />
                                        </TextBlock>
                                    </Border>

                                    <Border CornerRadius="6"
                                            Padding="8,3"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock FontSize="12">
                                            <Run Text="导入新增: " Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Run Text="{x:Bind ViewModel.SelectedEntryIncomingWords, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" 字" />
                                        </TextBlock>
                                    </Border>

                                    <Border CornerRadius="6"
                                            Padding="8,3"
                                            Background="{ThemeResource AppBadgeBackgroundBrush}"
                                            BorderBrush="{ThemeResource AppBadgeBorderBrush}"
                                            BorderThickness="1">
                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                                            <Run Text="合并后预计: " />
                                            <Run Text="{x:Bind ViewModel.SelectedEntryMergedWords, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" 字" />
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- 预览正文区 1：左右对照 (SideBySide) -->
                            <Grid Grid.Row="1"
                                  Visibility="{x:Bind local:ImportPage.GetTabVisibility(ViewModel.PreviewTabMode, 0), Mode=OneWay}"
                                  ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 左：本地已有正文卡片 (若无冲突则占位提示) -->
                                <Border Grid.Column="0"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        Padding="12">
                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <TextBlock Text="本地现有内容" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center">
                                                <Run Text="{x:Bind ViewModel.SelectedEntryExistingWords, Mode=OneWay}" /><Run Text=" 字" />
                                            </TextBlock>
                                        </Grid>

                                        <!-- 正文滚动容器 -->
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <TextBox Text="{x:Bind ViewModel.SelectedEntry.ExistingContent, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     FontSize="13"
                                                     PlaceholderText="（本地该日期尚无日记记录）" />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <!-- 右：待导入新日记正文卡片 -->
                                <Border Grid.Column="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        Padding="12">
                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="待导入内容" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                                <Border CornerRadius="4" Padding="6,2"
                                                        Background="{ThemeResource AppBadgeBackgroundBrush}"
                                                        BorderBrush="{ThemeResource AppBadgeBorderBrush}"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="可直接编辑" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center">
                                                    <Run Text="{x:Bind ViewModel.SelectedEntryIncomingWords, Mode=OneWay}" /><Run Text=" 字" />
                                                </TextBlock>

                                                <Button Style="{ThemeResource DefaultButtonStyle}"
                                                        Padding="8,4"
                                                        CornerRadius="6"
                                                        Click="ImportSelectedEntryBtn_Click"
                                                        ToolTipService.ToolTip="立即单独将此篇导入入库">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE8B5;" FontSize="11" />
                                                        <TextBlock Text="立即导入此篇" FontSize="11" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 正文滚动容器 -->
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <TextBox Text="{x:Bind ViewModel.SelectedEntry.Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="False"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     FontSize="13"
                                                     PlaceholderText="（待导入内容，支持直接在此编辑修改）" />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 预览正文区 2：合并预览 (MergedSimulation) -->
                            <Border Grid.Row="1"
                                    Visibility="{x:Bind local:ImportPage.GetTabVisibility(ViewModel.PreviewTabMode, 1), Mode=OneWay}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Padding="14">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="合并后内容预览" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                            <Border CornerRadius="4" Padding="6,2"
                                                    Background="{ThemeResource AppBadgeBackgroundBrush}"
                                                    BorderBrush="{ThemeResource AppBadgeBorderBrush}"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <TextBlock FontSize="11" FontWeight="Medium" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                                                    <Run Text="策略: " />
                                                    <Run Text="{x:Bind local:ImportPage.StrategyToDisplayName(ViewModel.ConflictStrategy), Mode=OneWay}" />
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock HorizontalAlignment="Right"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center">
                                            <Run Text="合并后字数: " /><Run Text="{x:Bind ViewModel.SelectedEntryMergedWords, Mode=OneWay}" /><Run Text=" 字" />
                                        </TextBlock>
                                    </Grid>

                                    <!-- 合并后完整 Markdown 内容 -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <TextBox Text="{x:Bind ViewModel.SelectedEntry.SimulatedMergedContent, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FontSize="13" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
