<Window
    x:Class="Journal.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Journal.Views"
    Title="Jot">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 材质着色与不透明度调节遮罩层 (纯色沉浸调节，穿透交互) -->
        <Border x:Name="BackdropTintOverlay"
                Grid.RowSpan="2"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                Opacity="0.0"
                IsHitTestVisible="False" />

        <!-- 自定义一体化标题栏拖拽区域 (AppTitleBar Drag Region) -->
        <Grid x:Name="AppTitleBar"
              Height="44"
              Background="Transparent"
              VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>

            <!-- 品牌标识与标题：与左侧浮动导航岛对齐 -->
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        Margin="18,0,0,0"
                        VerticalAlignment="Center">
                <Border Width="22"
                        Height="22"
                        CornerRadius="5"
                        Background="White"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Image Source="ms-appx:///Assets/jot.png"
                           Width="18"
                           Height="18"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Jot"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>

            <!-- 中间纯透明拖拽区域：支持单击拖拽与双击最大化/还原 -->
            <Grid Grid.Column="1" Background="Transparent" />

            <!-- 右侧系统三键避让区：预留约 140px，禁用点击拦截确保原生三键正常交互 -->
            <Grid Grid.Column="2" Background="Transparent" IsHitTestVisible="False" />
        </Grid>

        <!-- 主外壳视图承载区域 -->
        <views:ShellPage x:Name="ShellRoot" Grid.Row="1" />
    </Grid>
</Window>
